{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "jsx": "react-jsx",

    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist"
  },
  "include": ["src/**/*"],
}