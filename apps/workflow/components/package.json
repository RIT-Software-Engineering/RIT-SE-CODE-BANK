{
  "name": "@se-code-bank/workflows-components",
  "version": "1.0.0",
  "description": "A Workflows Ecosystem package for rendering workflows (and actions) on your frontend. Utilizes the Workflows Context system.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:js": "esbuild src/index.js --bundle --format=esm --outfile=dist/index.js --external:react --external:react-dom --external:react/* --external:react-dom/*",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "npm run build:js && npm run build:types",
    "prepare": "npm run build",
    "example": "node ./scripts/example.mjs",
    "examples": "npm run example"
  },
  "peerDependencies": {
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.9",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.7.0",
    "react-bootstrap": "^2.10.10"
  },
  "author": "Scott Happy",
  "license": "ISC"
}
