generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Action {
  id             String     @id @default(uuid()) @db.Char(36)
  name           String
  description    String?    @db.Text
  form           String?    @db.Text
  actionType     ActionType @default(simple)
  requireAllParticipants Boolean @default(false)
  requiresSubmission Boolean @default(false)
  submissionMimeTypes String? @db.VarChar(512)
  isFrozen       Boolean    @default(false) // Indicates if the action is frozen and cannot be modified (only the creator can change this)
  nextActionId   String?    @unique @db.Char(36)
  parentActionId String?    @db.Char(36)

  metadata           Metadata[]
  referenceEndpoints ReferenceEndpoint[]
  childActions       Action[]             @relation("ParentChild") // List of child actions
  parentAction       Action?              @relation("ParentChild", fields: [parentActionId], references: [id]) // Only one parent per Action
  nextAction         Action?              @relation("NextAction", fields: [nextActionId], references: [id]) // Next action in a chain
  previousAction     Action?              @relation("NextAction")
  baseActionOf       WorkflowAttributes?  @relation("baseAction")
  rootActionOf       WorkflowAttributes[] @relation("rootAction")
  permissions        Permission[]
  actionStates       ActionState[]
}

enum ActionType {
  simple
  workflow
  complex
  branching
}

model Metadata {
  id       String @id @default(uuid()) @db.Char(36)
  key      String
  value    String @db.Text
  actionId String @db.Char(36)

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([key, actionId])
}

// CAUTION: This system could be very insecure if not properly managed. 
// We may need to change to something different all together for security.
model ReferenceEndpoint {
  id       String @id @default(uuid()) @db.Char(36)
  name     String
  url      String
  method   String
  actionId String @db.Char(36)

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
}

model WorkflowAttributes {
  id           String  @id @default(uuid()) @db.Char(36)
  baseActionId String  @unique @db.Char(36) // The action that these attributes are added to
  rootActionId String? @db.Char(36) // The root action of the workflow, which is the base action

  baseAction     Action          @relation("baseAction", fields: [baseActionId], references: [id], onDelete: Cascade)
  rootAction     Action?         @relation("rootAction", fields: [rootActionId], references: [id], onDelete: Cascade)
  tags           Tag[]
  workflowStates WorkflowState[]
}

model Tag {
  id   String @id @default(uuid()) @db.Char(36)
  name String @unique

  workflowAttributes WorkflowAttributes[]
}

model Permission {
  id             String         @id @default(uuid()) @db.Char(36)
  userId         String         @db.Char(36)
  actionId       String         @db.Char(36)
  permissionType PermissionType

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
}

enum PermissionType {
  creator
  sharer
  editor
  viewer
}

model WorkflowState {
  id                String @id @default(uuid()) @db.Char(36)
  userId            String? @db.Char(36)
  teamId            String? @db.Char(36)
  workflowId        String @db.Char(36)
  baseActionStateId String @db.Char(36) @unique
  workflow        WorkflowAttributes @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  actionStates      ActionState[] @relation("ActionStates")
  baseActionState ActionState        @relation("BaseActionState", fields: [baseActionStateId], references: [id], onDelete: Cascade)
  participants WorkflowStateParticipant[]
}

model ActionState {
  id        String    @id @default(uuid()) @db.Char(36)
  actionId  String    @db.Char(36)
  stateType StateType
  index     Int
  parentId  String?    @db.Char(36) // If this action has a parent action

  action        Action          @relation(fields: [actionId], references: [id], onDelete: Cascade)
  parent        ActionState?     @relation("ParentChild", fields: [parentId], references: [id], onDelete: Cascade)
  children      ActionState[]   @relation("ParentChild")
  workflowStates      WorkflowState[]  @relation("ActionStates")
  workflowState WorkflowState? @relation("BaseActionState")
  submissions   ActionStateSubmission[]
}

model WorkflowStateParticipant {
  id               String @id @default(uuid()) @db.Char(36)
  workflowStateId  String @db.Char(36)
  userId           String @db.Char(36)

  workflowState WorkflowState @relation(fields: [workflowStateId], references: [id], onDelete: Cascade)

  @@unique([workflowStateId, userId])
}

enum StateType {
  completed
  inProgress
  notStarted
  hidden
}

model ActionStateSubmission {
  id            String   @id @default(uuid()) @db.Char(36)
  actionStateId String   @db.Char(36)
  userId        String   @db.Char(36)
  createdAt     DateTime @default(now())
  completed     Boolean  @default(false)
  completedAt   DateTime?
  fileName      String?  @db.VarChar(255)
  fileType      String?  @db.VarChar(255)
  fileSize      Int?
  fileData      Bytes?   @db.LongBlob

  actionState ActionState @relation(fields: [actionStateId], references: [id], onDelete: Cascade)

  @@unique([actionStateId, userId])
}
