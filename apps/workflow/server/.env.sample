# Change the placeholders "<placeholder_name>" to their respective information based on your MariaDB setup.
DATABASE_URL=mysql://root:password@localhost:3307/scoop_portal_demo

# Set the port to whatever works best for your application.
PORT=5001

# Change this to the url that the client will be running on so cors know where to expect requests from.
BASE_URL=http://localhost:3000

# Set this based on the environment you are trying to run this code in (development, production)
NODE_ENV=development
