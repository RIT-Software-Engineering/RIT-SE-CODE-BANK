model users {
  id                        String          @id @default(uuid())
  fname                     String
  lname                     String
  email                     String
  type                      String
  semester_group            String
  project                   String
  active                    String
  last_login                String
  prev_login                String
  owned_journal_entries     Journal_Entry[] @relation("OwnerJournalEntries")
  contactee_journal_entries Journal_Entry[] @relation("ContacteeJournalEntries")
}
