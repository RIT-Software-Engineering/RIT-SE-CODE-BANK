generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model fruit {
  id     String @id @default(uuid())
  name   String
  color  String
  size   String
  rating String @default("0")
}

model SemesterGroup {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(100)
  dept       String   @db.VarChar(100)
  start_date DateTime @default(now())
  end_date   DateTime @default(now())

  projects        Project[]
  journal_entries JournalEntry[]
  Teams           Teams[]
}

model Project {
  id           Int    @id @default(autoincrement())
  title        String
  display_name String
  description  String @db.VarChar(255)
  status       String @default("active") @db.VarChar(50)

  teams           Teams[]
  SemesterGroup   SemesterGroup? @relation(fields: [semesterGroupId], references: [id])
  semesterGroupId Int?

  proposal ProjectProposal?
}

model ProjectProposal {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewNotes String?  @db.Text
  createdAt   DateTime @default(now())

  submittedById String
  submittedBy   users  @relation("SubmittedProposals", fields: [submittedById], references: [id])

  reviewedById String?
  reviewedBy   users?  @relation("ReviewedProposals", fields: [reviewedById], references: [id])

  projectId Int?     @unique
  project   Project? @relation(fields: [projectId], references: [id])
}

model users {
  id             String  @id @default(uuid())
  fname          String
  lname          String
  email          String  @unique
  profilePicture String? @db.Text
  type           String
  semester_group String?
  project        String?
  active         String?
  last_login     String?
  prev_login     String?

  teams   Teams[] @relation("TeamMembers")
  login   Login?  @relation(fields: [loginId], references: [id])
  loginId Int?    @unique

  sentEntries     JournalEntry[] @relation("SentUserEntries")
  receivedEntries JournalEntry[] @relation("ReceivedUserEntries")
  topicEntries    JournalEntry[] @relation("TopicUserEntries")
  Teams           Teams[]

  submittedProposals ProjectProposal[] @relation("SubmittedProposals")
  reviewedProposals  ProjectProposal[] @relation("ReviewedProposals")
}

enum PrivacyEnum {
  PERSONAL
  PUBLIC
}

enum EntryType {
  MANUAL
  AUTOMATED
}

model JournalEntry {
  id               Int          @id @default(autoincrement())
  date             DateTime
  notes            String?      @db.VarChar(500)
  visibility_level Int?
  privacy_level    PrivacyEnum?
  entry_type       EntryType?
  sender_id        String
  topic_id         String
  recipients       users[]      @relation("ReceivedUserEntries")
  sender           users        @relation("SentUserEntries", fields: [sender_id], references: [id])
  topic            users        @relation("TopicUserEntries", fields: [topic_id], references: [id])

  previous_entryid Int?
  previous_entry   JournalEntry?  @relation("PreviousEntry", fields: [previous_entryid], references: [id])
  next_entries     JournalEntry[] @relation("PreviousEntry")

  Semester_Group   SemesterGroup? @relation(fields: [semester_GroupId], references: [id])
  semester_GroupId Int?
}

model Application {
  id                             Int      @id @default(autoincrement())
  applicant_id                   String?
  lastName                       String
  firstName                      String?
  ritEmail                       String
  userID                         String?
  coopsCompleted                 Int?
  startSemester                  String
  SEcoopReferral                 String?
  SEcoopReferralDetails          String?
  coopSearchStartDate            String?
  coopSearchPlatforms            String?
  pendingOffers                  Boolean
  pendingOffersDetails           String?
  rejectionLetters               Boolean
  rejectionLettersDetails        String?
  jobSearchAcknowledgment        Boolean?
  jobSearchAcknowledgmentDetails String?
  // SEcoopInterest          Boolean
  // SEcoopAvailability      Boolean?
  // remoteAbility           String?
  additionalComments             String?
  resumeFile                     Bytes?
  resumeFileName                 String?
  resumeFileType                 String?
  status                         String   @default("PENDING")
  createdAt                      DateTime @default(now())
}

model InterestForm {
  id               Int      @id @default(autoincrement())
  applicant_id     String?
  firstName        String
  lastName         String
  ritEmail         String
  userID           String?
  academicAdvisor  String?
  creditsRemaining String?
  cumulativeGPA    String?
  coursesTaken     String?
  status           String   @default("PENDING")
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewComments   String?
  createdAt        DateTime @default(now())
}

model Teams {
  id              Int            @id @default(autoincrement())
  name            String
  status          String         @default("active") @db.VarChar(50)
  scoopervisorId  String?
  projectId       Int?
  project         Project?       @relation(fields: [projectId], references: [id])
  semesterGroupId Int?
  SemesterGroup   SemesterGroup? @relation(fields: [semesterGroupId], references: [id])
  members         users[]        @relation("TeamMembers")
  scoopervisor    users?         @relation(fields: [scoopervisorId], references: [id])
}

model Login {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      users?
}
