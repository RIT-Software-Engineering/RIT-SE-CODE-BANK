// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Wraps shib user
model User {
  id    String @id @default(uuid()) @db.Char(36)
  name  String
  email String @unique

  // Required for relations
  projectsAsOverseer      Project[]      @relation("overseer")
  projectsAsPeers         Project[]      @relation("peers")
  peerResponseAsResponder FormResponse[] @relation("responderInFormResponse")
  peerResponseAsRespondee FormResponse[] @relation("respondeeInFormResponse")
  inAssessments           Assessment[]   @relation("receiversInAssessment")
  outAssessments          Assessment[]   @relation("responderInAssessment")
  Journal                 Journal[]
}

// ---------------------------------------
// PROJECT
// ---------------------------------------
model Project {
  id          String @id @default(uuid()) @db.Char(36)
  name        String
  description String @db.LongText
  overseer    User   @relation("overseer", fields: [overseerId], references: [id])
  overseerId  String @db.Char(36)
  peers       User[] @relation("peers")

  // Required for relations
  Assessment Assessment[]
}

// ---------------------------------------
// ASSESSMENTS
// ---------------------------------------
model Assessment {
  id             String       @id @default(uuid()) @db.Char(36)
  project        Project      @relation(fields: [projectId], references: [id])
  name           String
  description    String       @db.LongText
  receivers      User[]       @relation("receiversInAssessment")
  responders     User[]       @relation("responderInAssessment")
  feedbackForm   FeedbackForm @relation(fields: [feedbackFormId], references: [id])
  feedbackFormId String       @db.Char(36)
  startDate      DateTime
  dueDate        DateTime

  // Required for relations
  peerResponse FormResponse[]
  projectId    String         @db.Char(36)
}

model FormResponse {
  id         String            @id @default(uuid()) @db.Char(36)
  assessment Assessment        @relation(fields: [assessmentId], references: [id])
  responder  User              @relation("responderInFormResponse", fields: [responderId], references: [id])
  respondee  User              @relation("respondeeInFormResponse", fields: [respondeeId], references: [id])
  responses  InquiryResponse[]

  // Required for relations
  assessmentId String @db.Char(36)
  responderId  String @db.Char(36)
  respondeeId  String @db.Char(36)

  @@unique([assessmentId, responderId, respondeeId])
}

model InquiryResponse {
  id           String       @id @default(uuid()) @db.Char(36)
  Inquiry      Inquiry      @relation(fields: [inquiryId], references: [id])
  answer       String       @db.LongText // Interpret based on inquiry type
  FormResponse FormResponse @relation(fields: [formResponseId], references: [id])

  // Required for relations
  formResponseId String @db.Char(36)
  inquiryId      String @db.Char(36)

  @@unique([formResponseId, inquiryId])
}

// ---------------------------------------
// FEEDBACK FORMS
// ---------------------------------------
model FeedbackForm {
  id        String    @id @default(uuid()) @db.Char(36)
  name      String
  inquiries Inquiry[]

  // Required for relations
  Assessment Assessment[]
}

model Inquiry {
  id       String      @id @default(uuid()) @db.Char(36)
  type     InquiryType
  question String

  // For RATING
  scale  Int?
  labels String?

  // For RUBRIC
  rows RubricRow[]

  // Required for relations
  FeedbackForms       FeedbackForm[]
  PeerInquiryResponse InquiryResponse[]
}

enum InquiryType {
  FREE_RESPONSE
  RATING
  RUBRIC
}

model RubricRow {
  id      String @id @default(uuid()) @db.Char(36)
  label   String
  options String

  // Required for relations
  Inquiry Inquiry[]
}

// ---------------------------------------
// JOURNAL
// ---------------------------------------
model Journal {
  id   String @id @default(uuid()) @db.Char(36)
  user User   @relation(fields: [userId], references: [id])

  // Required for relations
  entries JournalEntry[]
  userId  String         @db.Char(36)

  @@unique([userId])
}

model JournalEntry {
  id          String            @id @default(uuid()) @db.Char(36)
  journal     Journal           @relation(fields: [journalId], references: [id])
  tags        JournalEntryTag[]
  re          String
  content     String            @db.LongText
  date        DateTime          @default(now())
  lastUpdated DateTime          @default(now())

  // Required for relations
  journalId String @db.Char(36)
}

model JournalEntryTag {
  id   String @id @default(uuid()) @db.Char(36)
  name String

  // Required for relations
  JournalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  journalEntryId String?       @db.Char(36)

  @@unique([name])
}
