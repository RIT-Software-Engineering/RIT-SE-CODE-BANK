{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "jsx": "react-jsx",

    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "noEmit": true,

    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/backend/node_modules"]
}