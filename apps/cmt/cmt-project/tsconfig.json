{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,

    "jsx": "react-jsx",

    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",

    "noEmit": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}