generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Event {
  id          Int        @id @default(autoincrement())
  title       String
  courseId    String?
  type        EventType
  time        String
  date        DateTime
  location    String
  description String?   @db.LongText
  importance  Importance
  course      course?    @relation(fields: [courseId], references: [id])

  @@index([courseId], map: "events_courseId_fkey")
  @@map("events")
}

model Professor {
  id        Int         @id @default(autoincrement())
  fname     String
  lname     String
  email     String
  course    course[]
  tbteamset tbteamset[]
  courseTemplates CourseTemplate[]

  @@map("professors")
}

model CourseTemplate {
  id           Int       @id @default(autoincrement())
  name         String
  semester     String
  weeks        Int
  assignments  Int
  exams        Int
  labs         Int
  projects     Int
  professorId  Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  professor    Professor @relation(fields: [professorId], references: [id])
  templateItems TemplateItem[]

  @@index([professorId], map: "CourseTemplate_professorId_fkey")
  @@map("course_templates")
}

model TemplateItem {
  id         Int            @id @default(autoincrement())
  templateId Int
  type       String         // "assignment", "exam", "lab", "project"
  name       String
  dueDate    DateTime?
  description String?
  template   CourseTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([templateId], map: "TemplateItem_templateId_fkey")
  @@map("template_items")
}
model course {
  id           String         @unique(map: "Course_id_key")
  name         String
  semester     String
  color        String
  students     Int
  professorId  Int
  professors   Professor      @relation(fields: [professorId], references: [id], map: "Course_professorId_fkey")
  events       Event[]
  tbenrollment tbenrollment[]
  tbteamset    tbteamset[]

  @@id([id, professorId])
  @@index([professorId], map: "Course_professorId_fkey")
}

model tbenrollment {
  id        Int        @id @default(autoincrement())
  courseId  String
  studentId String?
  email     String?
  firstName String?
  lastName  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime
  course    course     @relation(fields: [courseId], references: [id], map: "TBEnrollment_courseId_fkey")
  tbmember  tbmember[]

  @@unique([courseId, email], map: "TBEnrollment_courseId_email_key")
  @@unique([courseId, studentId], map: "TBEnrollment_courseId_studentId_key")
  @@index([courseId], map: "TBEnrollment_courseId_idx")
}

model tbmember {
  id           Int          @id @default(autoincrement())
  teamId       Int
  enrollmentId Int
  role         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  tbenrollment tbenrollment @relation(fields: [enrollmentId], references: [id], map: "TBMember_enrollmentId_fkey")
  tbteam       tbteam       @relation(fields: [teamId], references: [id], map: "TBMember_teamId_fkey")

  @@unique([teamId, enrollmentId], map: "TBMember_teamId_enrollmentId_key")
  @@index([enrollmentId], map: "TBMember_enrollmentId_idx")
}

model tbteam {
  id        Int        @id @default(autoincrement())
  teamSetId Int
  name      String
  maxSize   Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime
  tbmember  tbmember[]
  tbteamset tbteamset  @relation(fields: [teamSetId], references: [id], map: "TBTeam_teamSetId_fkey")

  @@unique([teamSetId, name], map: "TBTeam_teamSetId_name_key")
}

model tbteamset {
  id                   Int              @id @default(autoincrement())
  courseId             String
  name                 String
  status               tbteamset_status @default(DRAFT)
  teamSize             Int?
  constraints          String?          @db.LongText
  publishedAt          DateTime?
  archivedAt           DateTime?
  createdByProfessorId Int
  createdAt            DateTime         @default(now())
  updatedAt            DateTime
  tbteam               tbteam[]
  course               course           @relation(fields: [courseId], references: [id], map: "TBTeamSet_courseId_fkey")
  professors           Professor        @relation(fields: [createdByProfessorId], references: [id], map: "TBTeamSet_createdByProfessorId_fkey")

  @@unique([courseId, name], map: "TBTeamSet_courseId_name_key")
  @@index([courseId, status], map: "TBTeamSet_courseId_status_idx")
  @@index([createdByProfessorId], map: "TBTeamSet_createdByProfessorId_fkey")
}

enum EventType {
  exam
  assignment
  lecture
  lab
  office_hours
  meeting

  @@map("event_types")
}

enum Importance {
  Low
  Medium
  High

  @@map("importance_levels")
}

enum tbteamset_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}
