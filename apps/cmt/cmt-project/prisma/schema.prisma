generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EventType {
  exam
  assignment
  lecture
  lab
  office_hours
  meeting

  @@map("event_types")
}

enum Importance {
  Low
  Medium
  High

  @@map("importance_levels")
}

model Event {
  id          Int        @id @default(autoincrement())
  title       String
  courseId    String?
  type        EventType
  time        String
  date        DateTime
  location    String
  description String?
  importance  Importance
  preparation String?    @db.LongText
  course      Course?    @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@map("events")
}

model Professor {
  id        Int         @id @default(autoincrement())
  fname     String
  lname     String
  email     String
  courses   Course[]
  tbteamset TBTeamSet[]

  @@map("professors")
}

model Course {
  id           String @unique
  name         String
  semester     String
  color        String
  students     Int
  professorId  Int
  professors   Professor      @relation(fields: [professorId], references: [id])
  events       Event[]
  tbenrollment TBEnrollment[]
  tbteamset    TBTeamSet[]

  @@id([id, professorId])
  @@index([professorId])
}

model TBEnrollment {
  id          Int        @id @default(autoincrement())
  courseId    String
  studentId   String?
  email       String?
  firstName   String?
  lastName    String?
  createdAt   DateTime   @default(now())
  //updatedAt   DateTime
  course      Course     @relation(fields: [courseId], references: [id])
  members     TBMember[]

  @@unique([courseId, studentId])
  @@index([courseId])
}

model TBMember {
  id            Int          @id @default(autoincrement())
  teamId        Int
  enrollmentId  Int
  role          String?
  createdAt     DateTime     @default(now())
  //updatedAt     DateTime
  enrollment    TBEnrollment @relation(fields: [enrollmentId], references: [id])
  tbteam        TBTeam       @relation(fields: [teamId], references: [id])

  @@unique([teamId, enrollmentId])
  @@index([enrollmentId])
}

model TBTeam {
  id          Int        @id @default(autoincrement())
  teamSetId   Int
  name        String
  maxSize     Int?
  createdAt   DateTime   @default(now())
  //updatedAt   DateTime
  members     TBMember[]
  teamSet     TBTeamSet  @relation(fields: [teamSetId], references: [id])

  @@unique([teamSetId, name])
}

model TBTeamSet {
  id                   Int              @id @default(autoincrement())
  courseId             String
  name                 String
  status               tbteamset_status @default(DRAFT)
  teamSize             Int?
  constraints          String?          @db.LongText
  publishedAt          DateTime?
  archivedAt           DateTime?
  createdByProfessorId Int
  createdAt            DateTime         @default(now())
  //updatedAt            DateTime
  teams               TBTeam[]
  course               Course           @relation(fields: [courseId], references: [id])
  professors           Professor        @relation(fields: [createdByProfessorId], references: [id])

  @@unique([courseId, name])
  @@index([courseId, status])
  @@index([createdByProfessorId])
}

enum tbteamset_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}