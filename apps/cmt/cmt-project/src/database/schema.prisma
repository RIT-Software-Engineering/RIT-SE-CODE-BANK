// Defines an individual course
model Course {
    id          Int @id @default(autoincrement())
    code        String  // ex. SWEN340
    name        String
    semester    String
    sections    Section[]
}

// Represents how a course can have multiple sections
model Section {
    id              Int @id @default(autoincrement())
    sectionCode     Int
    courseId        Int
    course          Course @relation(fields: [courseId], references: [id])
    classTimes           CourseTime[]
}

// Indicates what days and times
model ClassTime {
    id          Int @id @default(autoincrement())
    dayOfWeek   DayOfWeek
    startTime   DateTime
    endTime     DateTime
    sectionId   Int
    section     Section @relation(fields: [sectionId], references: [id])
}
