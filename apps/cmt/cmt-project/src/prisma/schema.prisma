datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum DayOfWeek {
    MON
    TUE
    WED
    THU
    FRI
}

//model User {
    //username      String @id
    //uid           Int
    //fname         String
    //lname         String
    //email         String
//}

model Professor {
    id      Int @id @default(autoincrement()) // default ids, can change to use uids or something
    fname   String
    lname   String
    email   String
    courses Course_Creation[]
}

// Defines an individual course
model Course_Creation{
    id          String
    name        String
    semester    String
    professorId Int
    professor   Professor @relation(fields: [professorId], references: [id])
    sections    Section[]
    @@id([id, professorId])
}

// Represents how a course can have multiple sections
model Section {
    id              Int @id @default(autoincrement())
    sectionCode     Int // ex. 01
    courseId        String
    professorId     Int
    course          Course_Creation @relation(fields: [courseId, professorId], references: [id, professorId])
    classTimes      ClassTime[]
}

// Indicates what days and times
model ClassTime {
    id          Int @id @default(autoincrement())
    dayOfWeek   DayOfWeek
    startTime   DateTime
    endTime     DateTime
    sectionId   Int
    section     Section @relation(fields: [sectionId], references: [id])
}