// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Change to "mysql" or "sqlite" as needed
  url      = env("DATABASE_URL")
}

/* =========================
   Calendar / Events
   ========================= */

model Course {
  id       String  @id
  name     String
  color    String
  students Int
  events   Event[]

  @@map("courses")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  courseId    String?  // Optional for events that apply to all courses or admin events
  type        EventType
  time        String
  date        DateTime
  location    String
  description String?
  importance  Importance
  preparation String[] // Array of preparation items
  
  course      Course?  @relation(fields: [courseId], references: [id])

  @@map("events")
}

enum EventType {
  exam
  assignment
  lecture
  lab
  office_hours
  meeting
  
  @@map("event_types")
}

enum Importance {
  Low
  Medium
  High
  
  @@map("importance_levels")
}

/* =========================
   Team Builder (NEW)
   =========================
   - Instructor selects a Section, imports roster rows (TBEnrollment)
   - Generates a TeamSet (snapshot) per assignment/run
   - Teams + Members live under the TeamSet
*/

model TBEnrollment {
  id              Int     @id @default(autoincrement())
  sectionId       Int
  studentId       Int
  email           String?
  lastFirstName   String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  section         Section   @relation(fields: [sectionId], references: [[id]])

  @@unique([sectionId, email])
  @@unique([sectionId, studentId])
  @@index([sectionId])
}

//A snapshot of teams for a specific section
model TBTeamSet{
  id            Int
  sectionId     Int
  name          String
  status        TBTeamSetStatus @default(DRAFT)
  teamSize      Int?
  constraints   Json
  publishedAt   DateTime?
  archivedAt    DateTime?

  createdByProfessorId  Int
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  section               Section     @relation(fields: [sectionId], references: [id])
  createdByProfessor    Professor   @relation(fields: [createdByProfessorId], references: [id])
  teams                 TBTeam[]

  @@unique([sectionId, name])
  @@index([sectionId, status])
}

enum TBTeamSetStatus{
  DRAFT
  PUBLISHED
  ARCHIVED
}

//A single team within a teamset
model TBTeam{
  id      Int     @id @default(autoincrement())
  teamSetId   Int
  name        String
  maxSize     Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  teamSet     TBTeamSet   @relation(fields: [teamSetId], references: [id])
  members     TBMember[]

  @@unique([teamSetId, name])
}

//Membership connects a roster entity (TBEnrollment) to a team
//We link TBEnrollment (not a global User) so CSV-driven flow works
model TBMember{
  id    Int   @id @default(autoincrement())
  teamId    Int
  enrollmentId  Int
  role          String?  //optional: "lead", "scribe", etc
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  team          TBTeam      @relation(fields: [teamId], references: [id])
  enrollment    TBEnrollment    @relation(fields: [enrollmentId], references: [id])

  @@unique([teamId, enrollmentId])
  @@index([enrollmentId])
}