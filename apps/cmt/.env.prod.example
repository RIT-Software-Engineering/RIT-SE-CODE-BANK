NODE_ENV=production

BACKEND_PORT=5010
FRONTEND_PORT=3010
WORKFLOWS_PORT=5011

REACT_APP_BACKEND_URL=/api/cmt
REACT_APP_AUTH_BASE=https://apps.se.rit.edu/auth
PUBLIC_URL=/cmt
