  "scripts": {
    "start": "npx dotenv -e ./../.env -- craco start",
    "stop": "npx kill-port 3000 3010",
    "start-cmt": "npm run stop && npm run start",
    "build": "craco build",
    "test": "craco test",
    "eject": "react-scripts eject",
    "lint": "eslint \"src/**/*.{js,jsx}\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "nx": {
    "targets": {
      "start": {
        "continuous": true
      },
      "start-cmt": {
        "continuous": true
      }
    }
  },
  "devDependencies": {
