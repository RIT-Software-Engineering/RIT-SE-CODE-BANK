{
  "name": "cmt-backend",
  "version": "1.0.0",
  "description": "Backend API for Course Management Calendar",
  "main": "server.js",
  "scripts": {
    "start": "npx dotenv -e ./../.env -- node --watch server.js",
    "start-cmt": "npx dotenv -e ./../.env -- npx prisma db push && npx dotenv -e ./../.env -- node prisma/seed.js && npm run start",
    "lint": "eslint . || true"
  },
  "dependencies": {
    "@prisma/client": "^6.11.0",
    "@se-code-bank/cmt-shared-utilities": "*",
    "@se-code-bank/workflows-ecosystem": "*",
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^10.3.0",
    "express": "^5.2.1",
    "fs": "^0.0.1-security",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "prisma": "^6.11.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/multer": "^2.1.0",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.10"
  },
  "keywords": [
    "course",
    "calendar",
    "api",
    "backend"
  ],
  "nx": {
    "targets": {
      "start": {
        "continuous": true
      },
      "start-cmt": {
        "continuous": true
      }
    }
  },
  "author": "Your Name",
  "license": "MIT",
  "type": "module"
}
