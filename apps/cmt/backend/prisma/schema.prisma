generator client {
  provider = "prisma-client-js"
  output = "./generated/client" // Prevent prisma from placing client at root level
} 

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Professor {
  id              String              @id @default(uuid()) // String for compatibility with Workflows API
  fname           String
  lname           String
  email           String
  courses         Course[]
  offerings       CourseOffering[]
  tbteamset       TBTeamSet[]
  teachingSections SectionInstructor[] @relation("TeachingInstructor")
  instructorAssignments SectionInstructor[] @relation("InstructorAssignedBy")
  taAssignments SectionTA[]
  syncAcknowledgments SectionSyncAcknowledgment[]

  @@map("professors")
}

model Student {
  id          String         @id @default(uuid()) @db.Char(36)
  fname       String?
  lname       String?
  email       String         @unique @db.VarChar(254)
  enrollments TBEnrollment[]
  teachingSections SectionTA[]

  @@map("students")
}

model Course {
  id              Int            @id @default(autoincrement())
  name            String
  season          String?
  year            Int?
  classId         String
  color           String
  students        Int?
  section         String?
  days            String?
  startDate       String?
  active          Boolean        @default(true)
  professorId     String
  professors      Professor      @relation(fields: [professorId], references: [id])
  sessions        Session[]
  tbenrollment    TBEnrollment[]
  tbteamset       TBTeamSet[]
  workflowId      String
  workflowStateId String
  syllabusName        String?       // The actual syllabus is found in resources
  Resource        Resource[]
  isTemplate      Boolean       @default(false)
  offeringId      Int?
  offering        CourseOffering? @relation(fields: [offeringId], references: [id])
  instructors     SectionInstructor[]
  teachingAssistants SectionTA[]

  @@unique([offeringId, section])
}

model CourseOffering {
  id          Int      @id @default(autoincrement())
  name        String
  classId     String
  season      String?
  year        Int?
  startDate   String?
  professorId String
  professor   Professor @relation(fields: [professorId], references: [id])
  sections    Course[]
  syncIssues  SectionSyncIssue[]
}

model SectionInstructor {
  id                    Int       @id @default(autoincrement())
  courseId              Int
  professorId           String
  assignedByProfessorId String
  createdAt             DateTime  @default(now())
  course                Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professor             Professor @relation("TeachingInstructor", fields: [professorId], references: [id], onDelete: Cascade)
  assignedBy            Professor @relation("InstructorAssignedBy", fields: [assignedByProfessorId], references: [id])

  @@unique([courseId, professorId])
  @@index([professorId])
}

model SectionTA {
  id                    Int       @id @default(autoincrement())
  courseId              Int
  studentProfileId      String    @db.Char(36)
  assignedByProfessorId String
  createdAt             DateTime  @default(now())
  course                Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student               Student   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  assignedBy            Professor @relation(fields: [assignedByProfessorId], references: [id])

  @@unique([courseId, studentProfileId])
  @@index([studentProfileId])
}

model SectionSyncAcknowledgment {
  issueId     Int
  professorId String
  occurrence  Int
  dismissedAt DateTime @default(now())
  issue       SectionSyncIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@id([issueId, professorId])
  @@index([professorId])
}

model SectionSyncIssue {
  id          Int      @id @default(autoincrement())
  offeringId  Int
  issueKey    String   @db.VarChar(191)
  details     Json
  resolved    Boolean  @default(false)
  occurrence  Int      @default(1)
  dismissedAt DateTime?
  updatedAt   DateTime @updatedAt
  offering    CourseOffering @relation(fields: [offeringId], references: [id])
  acknowledgments SectionSyncAcknowledgment[]

  @@unique([offeringId, issueKey])
}

model Session {
  id          Int        @id @default(autoincrement())
  sessionNum  Int
  courseId    Int
  completed   Boolean    @default(false)  // TODO Needs to be added for workflow actions too
  canceled    Boolean    @default(false)
  canceledAt  DateTime?
  asid        String?                     // TODO add workflow actions here
  date        String?
  course      Course  @relation(fields: [courseId], references: [id])
  material    SessionMaterial[]
  blocks      SessionBlock[]
  sharedKey   String? @default(uuid())
  teachingWeek Int?

  @@index([courseId, sharedKey])
}

model SessionMaterial {
  id          Int        @id @default(autoincrement())
  type        String
  label       String    @db.Text
  body        String?   @db.Text
  active      Boolean   @default(true)
  sessionId   Int
  sessionNum  Int
  blockId     Int?
  session     Session @relation(fields: [sessionId], references: [id])
  block       SessionBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  sharedKey   String? @default(uuid())

  @@index([sharedKey])
}

model SessionBlock {
  id        Int                @id @default(autoincrement())
  name      String
  status    session_block_status @default(NOT_STARTED)
  position  Int                @default(0)
  sessionId Int
  session   Session            @relation(fields: [sessionId], references: [id])
  material  SessionMaterial[]
  sharedKey String? @default(uuid())

  @@index([sessionId, position])
  @@index([sharedKey])
}

model TBEnrollment {
  id        Int        @id @default(autoincrement())
  courseId  Int
  studentId String?
  email     String?
  firstName String?
  lastName  String?
  createdAt DateTime   @default(now())
  course    Course     @relation(fields: [courseId], references: [id])
  members   TBMember[]
  studentProfileId String? @db.Char(36)
  studentProfile Student? @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([courseId, email])
  @@unique([courseId, studentId])
  @@unique([courseId, studentProfileId])
  @@index([courseId])
  @@index([studentProfileId])
}

model TBMember {
  id           Int          @id @default(autoincrement())
  teamId       Int
  enrollmentId Int
  role         String?
  createdAt    DateTime     @default(now())
  enrollment   TBEnrollment @relation(fields: [enrollmentId], references: [id])
  tbteam       TBTeam       @relation(fields: [teamId], references: [id])

  @@unique([teamId, enrollmentId])
  @@index([enrollmentId])
}

model TBTeam {
  id        Int       @id @default(autoincrement())
  teamSetId Int
  name      String
  maxSize   Int?
  createdAt DateTime  @default(now())
  members   TBMember[]
  teamSet   TBTeamSet @relation(fields: [teamSetId], references: [id])

  @@unique([teamSetId, name])
}

model TBTeamSet {
  id                   Int              @id @default(autoincrement())
  courseId             Int
  name                 String
  status               tbteamset_status @default(DRAFT)
  teamSize             Int?
  constraints          String?          @db.LongText
  publishedAt          DateTime?
  createdByProfessorId String
  createdAt            DateTime         @default(now())
  teams                TBTeam[]
  course               Course           @relation(fields: [courseId], references: [id])
  professors           Professor        @relation(fields: [createdByProfessorId], references: [id])

  @@unique([courseId, name])
  @@index([courseId, status])
  @@index([createdByProfessorId])
}

model Resource {
  id        String      @id @default(uuid()) @db.Char(36)
  name      String
  filename  String
  mimeType  String
  filePath  String
  courseId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isSyllabus Boolean @default(false)
  sharedKey  String? @default(uuid())
  course    Course   @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@map("resources")
}

enum tbteamset_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum session_block_status {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}
