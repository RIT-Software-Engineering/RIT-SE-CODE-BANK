generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  username  String     @id @db.VarChar(7)
  uid       Int        @unique
  fname     String     @db.Text
  lname     String     @db.Text
  password  String     @db.Text
  email     String     @unique @db.VarChar(255)
  pronouns  String     @db.Text
  role      Role       @default(GUEST)
  candidate Candidate?
  employer  Employer?
}

model Candidate {
  username                      String                          @id
  year                          Int
  major                         String                          @db.Text
  graduateStatus                GraduateStatus                  @default(UNDERGRADUATE)
  wasPriorEmployee              Boolean
  user                          User                            @relation(fields: [username], references: [username])
  courseHistory                 CourseHistory[]
  employee                      Employee[]
  jobPositionApplicationHistory JobPositionApplicationHistory[]
  resumes                       Resume[]
  coverLetters                  CoverLetter[]
}

model Comment {
  id               Int      @id @default(autoincrement())
  author           String
  foreignTableName String   @db.Text
  foreignKey       String   @db.Text
  status           String   @db.Text
  comment          String   @db.Text
  timestamp        DateTime
}

model Resume {
  id                              Int                             @id @default(autoincrement())
  name                            String                          @db.Text
  username                        String
  isPrimary                       Boolean
  isSoftDeleted                   Boolean                         @default(false)
  resumeURL                       String
  candidate                       Candidate                       @relation(fields: [username], references: [username])
  jobPositionApplicationHistories JobPositionApplicationHistory[]

  @@index([username], map: "Resume_username_fkey")
}

model CoverLetter {
  id                              Int                             @id @default(autoincrement())
  name                            String                          @db.Text
  username                        String
  coverLetterURL                  String
  candidate                       Candidate                       @relation(fields: [username], references: [username])
  jobPositionApplicationHistories JobPositionApplicationHistory[]

  @@index([username], map: "Cover_Letter_username_fkey")
}

model Employer {
  username     String        @id
  department   String        @db.Text
  user         User          @relation(fields: [username], references: [username])
  jobPositions JobPosition[]
}

model Employee {
  id                 Int                  @id
  username           String
  employeeStatus     EmployeeStatus       @default(ACTIVE)
  candidate          Candidate            @relation(fields: [username], references: [username])
  jobPositionHistory JobPositionHistory[]

  @@index([username], map: "Employee_username_fkey")
}

model JobPositionHistory {
  id                       Int                      @id @default(autoincrement())
  jobPositionId            String
  employeeId               Int
  jobPositionHistoryStatus JobPositionHistoryStatus @default(ACTIVE)
  employee                 Employee                 @relation(fields: [employeeId], references: [id])
  jobPosition              JobPosition              @relation(fields: [jobPositionId], references: [id])
  timecardWeeklyHistory    TimecardWeeklyHistory[]

  @@index([employeeId], map: "JobPositionHistory_employeeId_fkey")
  @@index([jobPositionId], map: "JobPositionHistory_jobPositionId_fkey")
}

model JobPositionApplicationHistory {
  id                              Int                  @id @default(autoincrement())
  username                        String
  candidateUID                    Int
  jobPositionId                   String
  resumeId                        Int
  jobApplicationStatus            JobApplicationStatus @default(APPLIED)
  candidateFName                  String               @db.Text
  candidateLName                  String               @db.Text
  candidatePronouns               String               @db.Text
  candidateEmail                  String               @db.Text
  candidateMajor                  String               @db.Text
  candidateYear                   Int
  candidateGrade                  Grade?
  wasPriorEmployeeForThisCourse   Boolean
  wasPriorEmployeeForOtherCourses Boolean
  priorEmploymentHistory          String?              @db.Text
  coverLetterId                   Int?
  jobPosition                     JobPosition          @relation(fields: [jobPositionId], references: [id])
  resume                          Resume               @relation(fields: [resumeId], references: [id])
  coverLetter                     CoverLetter?         @relation(fields: [coverLetterId], references: [id])
  candidate                       Candidate            @relation(fields: [username], references: [username])

  @@index([jobPositionId], map: "JobPositionApplicationHistory_jobPositionId_fkey")
  @@index([resumeId], map: "JobPositionApplicationHistory_resumeId_fkey")
  @@index([coverLetterId], map: "JobPositionApplicationHistory_coverLetterId_fkey")
  @@index([username], map: "JobPositionApplicationHistory_username_fkey")
}

model CourseHistory {
  id               Int       @id @default(autoincrement())
  username         String
  courseCode       String    @db.VarChar(8)
  grade            Grade?
  hasTaken         Boolean
  wasPriorEmployee Boolean
  course           Course    @relation(fields: [courseCode], references: [courseCode])
  candidate        Candidate @relation(fields: [username], references: [username])

  @@index([courseCode], map: "CourseHistory_courseCode_fkey")
  @@index([username], map: "CourseHistory_username_fkey")
}

model Course {
  courseCode    String          @id @db.VarChar(8)
  name          String          @db.Text
  description   String          @db.Text
  courseHistory CourseHistory[]
  jobPositions  JobPosition[]
}

model JobPosition {
  id                            String                          @id
  courseCode                    String                          @db.VarChar(8)
  sectionNumber                 Int
  semesterCode                  Int
  username                      String
  maxTAs                        Int
  jobPositionStatus             JobPositionStatus               @default(PENDING_APPROVAL)
  location                      String                          @db.Text
  locationType                  LocationType
  graduateStatusRequirement     GraduateStatus?
  gradeRequirement              Grade?
  courseTakenRequirement        Boolean
  startDate                     DateTime
  endDate                       DateTime
  course                        Course                          @relation(fields: [courseCode], references: [courseCode])
  employer                      Employer                        @relation(fields: [username], references: [username])
  jobPositionApplicationHistory JobPositionApplicationHistory[]
  jobPositionHistory            JobPositionHistory[]
  jobSchedules                  JobSchedule[]

  @@index([courseCode], map: "JobPosition_courseCode_fkey")
  @@index([username], map: "JobPosition_username_fkey")
}

model JobSchedule {
  id            Int         @id @default(autoincrement())
  jobPositionId String
  dayOfWeek     String      @db.Text
  startTime     DateTime    @db.Time(0)
  endTime       DateTime    @db.Time(0)
  jobPosition   JobPosition @relation(fields: [jobPositionId], references: [id])

  @@index([jobPositionId], map: "JobSchedule_jobPositionId_fkey")
}

model TimecardWeeklyHistory {
  id                   Int                @id @default(autoincrement())
  jobPositionHistoryId Int
  isCurrentWeek        Boolean
  weekStartDate        DateTime           @db.Date
  dailyEntries         TimecardDay[]
  jobPositionHistory   JobPositionHistory @relation(fields: [jobPositionHistoryId], references: [id])

  @@index([jobPositionHistoryId])
}

model TimecardDay {
  id                      String                @id
  day                     DateTime              @db.Date
  timecardWeeklyHistoryId Int
  notes                   String?               @db.Text
  duration                Decimal               @db.Decimal(10, 2)
  timeIn1                 DateTime?             @db.Time(0)
  timeOut1                DateTime?             @db.Time(0)
  timeIn2                 DateTime?             @db.Time(0)
  timeOut2                DateTime?             @db.Time(0)
  timeIn3                 DateTime?             @db.Time(0)
  timeOut3                DateTime?             @db.Time(0)
  timecardWeeklyHistory   TimecardWeeklyHistory @relation(fields: [timecardWeeklyHistoryId], references: [id])

  @@index([timecardWeeklyHistoryId])
}

model FeatureFlag {
  // Fields
  name      String   @id @db.VarChar(50) // e.g., "MESSAGING", "TIMECARD", "POSITIONS"
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

enum Role {
  GUEST
  CANDIDATE
  EMPLOYEE
  EMPLOYER
  ADMIN
}

enum GraduateStatus {
  UNDERGRADUATE
  GRADUATE
}

enum EmployeeStatus {
  ACTIVE
  TERMINATED
  INACTIVE
}

enum JobPositionHistoryStatus {
  ACTIVE
  TERMINATED
  INACTIVE
}

enum JobApplicationStatus {
  APPLIED
  HIRED
  ACCEPTED_OFFER
  DECLINED_OFFER
  PENDING_OFFER
  INTERVIEW
  ONHOLD
  REJECTED
  INACTIVE
}

enum Grade {
  A
  A_MINUS
  B_PLUS
  B
  B_MINUS
  C_PLUS
  C
  C_MINUS
  D
  F
}

enum LocationType {
  INPERSON
  HYBRID
  REMOTE
}

enum JobPositionStatus {
  ACTIVE
  OPEN
  FILLED
  ONHOLD
  INACTIVE
  PENDING_APPROVAL
  REJECTED
}
