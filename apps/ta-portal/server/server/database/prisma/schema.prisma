// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////
/// MODEL TABLES
//////////////////////////////////////////////////

model User {
  //Fields
  uid      Int    @id
  name     String @db.Text
  email    String @db.Text
  pronouns String @db.Text
  role     Role   @default(GUEST)

  //Relationships
  candidate Candidate?
  employer  Employer?
}

model Candidate {
  //Fields
  uid                Int            @id
  year               Int            @db.Int
  major              String         @db.Text
  graduateStatus     GraduateStatus @default(UNDERGRADUATE)
  wasPriorEmployee   Boolean        @db.TinyInt

  //Relationships
  user                              User                              @relation(fields: [uid], references: [uid])
  resumes                           Resume[]
  courseHistory                     CourseHistory[]
  employees                         Employee[]
  jobPositionApplicationHistory     JobPositionApplicationHistory[]
}

model Comment {
  //Fields
  id                Int             @id @default(autoincrement())
  foreignTableName  String          @db.Text
  foreignKey        String          @db.Text                      //this is the id of a specific entry within one of the foreign tables
  status            String          @db.Text
  comment           String          @db.Text
  timestamp         DateTime
}

model Resume {
  //Fields
  id                  Int           @id @default(autoincrement())
  name                String        @db.Text
  candidateUID        Int
  isPrimary           Boolean       @db.TinyInt
  resumeURL           String

  //Relationships
  candidate          Candidate      @relation(fields: [candidateUID], references: [uid])
  jobPositionApplicationHistory     JobPositionApplicationHistory[]
}

model Employer {
  //Fields
  uid        Int    @id
  department String @db.Text

  //Relationships
  user        User          @relation(fields: [uid], references: [uid])
  jobPostions JobPosition[]
}

model Employee {
  //Fields
  id             Int            @id //employee id that RIT gives to you when you start working under a new position (like a Course Assistant)
  candidateUID   Int
  employeeStatus EmployeeStatus @default(ACTIVE)

  //Relationships
  candidate          Candidate            @relation(fields: [candidateUID], references: [uid])
  jobPositionHistory JobPositionHistory[]
}

model JobPositionHistory {
  //Fields
  id                       Int                      @id @default(autoincrement())
  jobPositionId            String
  employeeId               Int
  jobPositionHistoryStatus JobPositionHistoryStatus @default(ACTIVE)

  // Relations
  jobPosition    JobPosition      @relation(fields: [jobPositionId], references: [id])
  employee       Employee?        @relation(fields: [employeeId], references: [id])
  timeLogHistory TimeLogHistory[]
}

model JobPositionApplicationHistory {
  //Fields
  id                                 Int                  @id @default(autoincrement())
  candidateUID                       Int
  jobPositionId                      String
  resumeId                           Int
  jobApplicationStatus               JobApplicationStatus @default(APPLIED)
  candidateName                      String               @db.Text
  candidatePronouns                  String               @db.Text
  candidateEmail                     String               @db.Text
  candidateMajor                     String               @db.Text
  candidateYear                      Int
  candidateGrade                     Grade?
  wasPriorEmployeeForThisCourse      Boolean              @db.TinyInt
  wasPriorEmployeeForOtherCourses    Boolean              @db.TinyInt
  priorEmploymentHistory             String?              @db.Text
  coverLetterName                    String?              @db.Text
  coverLetterURL                     String?

  // Relations
  candidate   Candidate   @relation(fields: [candidateUID], references: [uid])
  resume      Resume      @relation(fields: [resumeId], references: [id])
  jobPosition JobPosition @relation(fields: [jobPositionId], references: [id])
}

//This table to storing specifically past courses a Candidate has taken before or has been an employee in the past
model CourseHistory {
  //Fields
  id               Int      @id @default(autoincrement())
  candidateUID     Int
  courseCode       String   @db.VarChar(8)
  grade            Grade? //Letter Grade
  hasTaken         Boolean  @db.TinyInt
  wasPriorEmployee Boolean  @db.TinyInt

  // Relations
  candidate Candidate @relation(fields: [candidateUID], references: [uid])
  course    Course    @relation(fields: [courseCode], references: [courseCode])
}

//This table is a generic table of all of the course that RIT has to offer
model Course {
  //Fields
  courseCode  String @id @db.VarChar(8)
  name        String @db.Text
  description String @db.Text

  // Relations
  jobPositions  JobPosition[]
  courseHistory CourseHistory[]
}

model JobPosition {
  //Fields
  id                          String          @id // For for id here is SemesterCode-CourseCode-SectionNumber
  courseCode                  String          @db.VarChar(8)
  sectionNumber               Int
  semesterCode                Int
  employerUID                 Int
  maxCAs                      Int
  jobPositionStatus           JobPositionStatus @default(PENDING_APPROVAL)
  location                    String          @db.Text
  locationType                LocationType
  graduateStatusRequirement   GraduateStatus?
  gradeRequirement            Grade?
  courseTakenRequirement      Boolean         @db.TinyInt
  startDate                   DateTime
  endDate                     DateTime

  // Relations
  course                          Course                            @relation(fields: [courseCode], references: [courseCode])
  employer                         Employer                         @relation(fields: [employerUID], references: [uid])
  jobSchedules                    JobSchedule[]
  jobPositionHistory              JobPositionHistory[]
  jobPositionApplicationHistory   JobPositionApplicationHistory[]
}

model JobSchedule {
  //Fields
  id            Int      @id @default(autoincrement())
  jobPositionId String
  dayOfWeek     String   @db.Text
  startTime     DateTime @db.Time
  endTime       DateTime @db.Time

  // Relations
  jobPosition JobPosition @relation(fields: [jobPositionId], references: [id])
}

model TimeLogHistory {
  //Fields
  id                   Int @id @default(autoincrement())
  timeLogId            String
  jobPositionHistoryId Int

  // Relations
  jobPositionHistory JobPositionHistory @relation(fields: [jobPositionHistoryId], references: [id])
  timeLog            TimeLog            @relation(fields: [timeLogId], references: [id])

  @@unique([jobPositionHistoryId, timeLogId])
}

model TimeLog {
  //Fields
  id            String   @id //startdatetime-enddatetime-EmployeeId
  startDateTime DateTime
  endDateTime   DateTime?
  notes         String   @db.Text
  duration      Decimal

  // Relations
  timeLogHistory TimeLogHistory[]
}


//////////////////////////////////////////////////
/// ENUM MAPS
//////////////////////////////////////////////////

enum Role {
  GUEST
  CANDIDATE
  EMPLOYEE
  EMPLOYER
  ADMIN
}

enum GraduateStatus {
  UNDERGRADUATE
  GRADUATE
}

enum EmployeeStatus {
  ACTIVE
  TERMINATED
  INACTIVE
}

enum JobPositionHistoryStatus {
  //these roles are for when employees are currently working within a job position
  ACTIVE
  TERMINATED // When the candidate is fired
  INACTIVE // When the job position is no longer available (e.g., end of semester)
}

enum JobApplicationStatus {
  //these roles are for when candidates are applying to the job positions
  APPLIED
  HIRED
  ACCEPTED_OFFER
  PENDING_OFFER
  INTERVIEW
  ONHOLD
  REJECTED
  INACTIVE
  //any withdrawal or deletion of a job position will delete the jobposition application altogether
}

enum Grade {
  A
  A_MINUS
  B_PLUS
  B
  B_MINUS
  C_PLUS
  C
  C_MINUS
  D
  F
}

enum LocationType {
  INPERSON
  HYBRID
  REMOTE
}

enum JobPositionStatus {
  ACTIVE
  OPEN
  FILLED
  ONHOLD
  INACTIVE
  PENDING_APPROVAL
}