// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////
/// MODEL TABLES
//////////////////////////////////////////////////

model User {
  //Fields
  username String @id @db.VarChar(7) // RIT user id that's normally at the front of your email address (i.e. xyz1234)
  uid      Int    @unique            // 9 digit numeric id
  fname    String @db.Text           // first name
  lname    String @db.Text           // last name
  password String @db.Text
  email    String @unique @db.VarChar(255)
  pronouns String @db.Text
  role     Role   @default(GUEST)    // we have the role types be GUEST, CANDIDATE, EMPLOYEE, EMPLOYER, & ADMIN

  //Relationships
  candidate Candidate?
  employer  Employer?
}

model Candidate {
  //Fields
  username           String         @id
  year               Int            @db.Int
  major              String         @db.Text
  graduateStatus     GraduateStatus @default(UNDERGRADUATE)
  wasPriorEmployee   Boolean

  //Relationships
  user                          User                            @relation(fields: [username], references: [username])
  resumes                       Resume[]
  courseHistory                 CourseHistory[]
  employee                      Employee[]
  jobPositionApplicationHistory JobPositionApplicationHistory[]
}

model Comment {
  //Fields
  id               Int      @id @default(autoincrement())
  author           String            //this is the full name of the user who wrote the comment
  foreignTableName String   @db.Text
  foreignKey       String   @db.Text //this is the id of a specific entry within one of the foreign tables
  status           String   @db.Text
  comment          String   @db.Text
  timestamp        DateTime
}

model Resume {
  //Fields
  id          Int     @id @default(autoincrement())
  name        String  @db.Text
  username    String //Foreign key for the user table (specificallly users who are in the candidate table)
  isPrimary   Boolean
  resumeURL   String

  //Relationships
  candidate                     Candidate                       @relation(fields: [username], references: [username])
  jobPositionApplicationHistory JobPositionApplicationHistory[]
}

model Employer {
  //Fields
  username    String @id //Foreign key for the user table
  department  String @db.Text

  //Relationships
  user        User          @relation(fields: [username], references: [username])
  jobPostions JobPosition[]
}

model Employee {
  //Fields
  id             Int          @id //employee id that RIT gives to you when you start working under a new position (like a Course Assistant)
  username       String       //Foreign key for the user table (specificallly users who are in the candidate table)
  employeeStatus EmployeeStatus @default(ACTIVE)

  //Relationships
  candidate          Candidate            @relation(fields: [username], references: [username])
  jobPositionHistory JobPositionHistory[]
}

model JobPositionHistory {
  //Fields
  id                       Int                      @id @default(autoincrement())
  jobPositionId            String
  employeeId               Int
  jobPositionHistoryStatus JobPositionHistoryStatus @default(ACTIVE)

  // Relations
  jobPosition           JobPosition      @relation(fields: [jobPositionId], references: [id])
  employee              Employee?        @relation(fields: [employeeId], references: [id])
  timecardWeeklyHistory TimecardWeeklyHistory[]
}

model JobPositionApplicationHistory {
  //Fields
  id                              Int                  @id @default(autoincrement())
  username                        String               //Foreign key for the user table (specificallly users who are in the candidate table)
  candidateUID                    Int
  jobPositionId                   String
  resumeId                        Int
  jobApplicationStatus            JobApplicationStatus @default(APPLIED)
  candidateFName                  String               @db.Text
  candidateLName                  String               @db.Text
  candidatePronouns               String               @db.Text
  candidateEmail                  String               @db.Text
  candidateMajor                  String               @db.Text
  candidateYear                   Int
  candidateGrade                  Grade?
  wasPriorEmployeeForThisCourse   Boolean
  wasPriorEmployeeForOtherCourses Boolean
  priorEmploymentHistory          String?              @db.Text
  coverLetterName                 String?              @db.Text
  coverLetterURL                  String?

  // Relations
  candidate   Candidate   @relation(fields: [username], references: [username])
  resume      Resume      @relation(fields: [resumeId], references: [id])
  jobPosition JobPosition @relation(fields: [jobPositionId], references: [id])
}

//This table to storing specifically past courses a Candidate has taken before or has been an employee in the past
model CourseHistory {
  //Fields
  id               Int     @id @default(autoincrement())
  username         String  //Foreign key for the user table (specificallly users who are in the candidate table)
  courseCode       String  @db.VarChar(8)
  grade            Grade?  //Letter Grade
  hasTaken         Boolean
  wasPriorEmployee Boolean

  // Relations
  candidate Candidate @relation(fields: [username], references: [username])
  course    Course    @relation(fields: [courseCode], references: [courseCode])
}

//This table is a generic table of all of the course that RIT has to offer
model Course {
  //Fields
  courseCode  String @id @db.VarChar(8)
  name        String @db.Text
  description String @db.Text

  // Relations
  jobPositions  JobPosition[]
  courseHistory CourseHistory[]
}

model JobPosition {
  //Fields
  id                        String            @id // For for id here is SemesterCode-CourseCode-SectionNumber
  courseCode                String            @db.VarChar(8)
  sectionNumber             Int
  semesterCode              Int
  username                  String            //Foreign key for the user table (specificallly users who are in the employer table)
  maxTAs                    Int
  jobPositionStatus         JobPositionStatus @default(PENDING_APPROVAL)
  location                  String            @db.Text
  locationType              LocationType
  graduateStatusRequirement GraduateStatus?
  gradeRequirement          Grade?
  courseTakenRequirement    Boolean
  startDate                 DateTime
  endDate                   DateTime

  // Relations
  course                        Course                        @relation(fields: [courseCode], references: [courseCode])
  employer                      Employer                      @relation(fields: [username], references: [username])
  jobSchedules                  JobSchedule[]
  jobPositionHistory            JobPositionHistory[]
  jobPositionApplicationHistory JobPositionApplicationHistory[]
}

model JobSchedule {
  //Fields
  id            Int      @id @default(autoincrement())
  jobPositionId String
  dayOfWeek     String   @db.Text
  startTime     DateTime @db.Time
  endTime       DateTime @db.Time

  // Relations
  jobPosition JobPosition @relation(fields: [jobPositionId], references: [id])
}

// =============================================================================
// TIMECARD TABLES
// =============================================================================

model TimecardWeeklyHistory {
  // Fields
  id                   Int      @id @default(autoincrement())
  jobPositionHistoryId Int
  isCurrentWeek        Boolean
  weekStartDate        DateTime @db.Date

  // Relations
  jobPositionHistory JobPositionHistory @relation(fields: [jobPositionHistoryId], references: [id])
  dailyEntries       TimecardDay[]

  @@index([jobPositionHistoryId])
}

model TimecardDay {
  // Fields
  id                      String    @id // Composite Key: employeeID-day
  day                     DateTime  @db.Date
  timecardWeeklyHistoryId Int
  notes                   String?   @db.Text
  duration                Decimal   @db.Decimal(10, 2)
  timeIn1                 DateTime? @db.Time
  timeOut1                DateTime? @db.Time
  timeIn2                 DateTime? @db.Time
  timeOut2                DateTime? @db.Time
  timeIn3                 DateTime? @db.Time
  timeOut3                DateTime? @db.Time

  // Relations
  timecardWeeklyHistory TimecardWeeklyHistory @relation(fields: [timecardWeeklyHistoryId], references: [id])

  @@index([timecardWeeklyHistoryId])
}


//////////////////////////////////////////////////
/// ENUM MAPS
//////////////////////////////////////////////////

enum Role {
  GUEST
  CANDIDATE
  EMPLOYEE
  EMPLOYER
  ADMIN
}

enum GraduateStatus {
  UNDERGRADUATE
  GRADUATE
}

enum EmployeeStatus {
  ACTIVE
  TERMINATED
  INACTIVE
}

enum JobPositionHistoryStatus {
  //these roles are for when employees are currently working within a job position
  ACTIVE
  TERMINATED // When the candidate is fired
  INACTIVE // When the job position is no longer available (e.g., end of semester)
}

enum JobApplicationStatus {
  //these roles are for when candidates are applying to the job positions
  APPLIED
  HIRED
  ACCEPTED_OFFER
  DECLINED_OFFER //used to rejct offers given by employers/admin
  PENDING_OFFER
  INTERVIEW
  ONHOLD
  REJECTED //used for rejecting applications made by candidate/employee
  INACTIVE
  //any deletion of a job position will delete the jobposition application altogether
}

enum Grade {
  A
  A_MINUS
  B_PLUS
  B
  B_MINUS
  C_PLUS
  C
  C_MINUS
  D
  F
}

enum LocationType {
  INPERSON
  HYBRID
  REMOTE
}

enum JobPositionStatus {
  ACTIVE
  OPEN
  FILLED
  ONHOLD
  INACTIVE
  PENDING_APPROVAL
  REJECTED
}