{
  "name": "server",
  "version": "1.0.0",
  "main": "main.js",
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "start": "node main.js",
    "dev": "nodemon main.js",
    "setup_db": "node ./server/database/setup_db.js",
    "prisma:delete-migration": "cd ./server/database/prisma && rm -rf migrations",
    "prisma:generate": "cd ./server/database/prisma && npx prisma generate",
    "prisma:migrate": "cd ./server/database/prisma && npx prisma migrate dev",
    "prisma:reset": "cd ./server/database/prisma && npx prisma migrate reset --force"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "axios": "^1.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "multer": "^2.0.1",
    "nodemon": "^3.1.10",
    "os": "^0.1.2"
  },
  "devDependencies": {
    "jest": "^30.1.3",
    "mysql2": "^3.14.3",
    "node-mocks-http": "^1.17.2",
    "node-sql-parser": "^5.3.10",
    "prisma": "^6.11.1",
    "supertest": "^7.1.4"
  },
  "prisma": {
    "seed": "node ./seed.js"
  }
}
