# Service
PORT=3001
AUTH_BASE_URL=http://localhost:3001
CLIENT_ORIGIN=http://localhost:5173    # or http://localhost:3000 for CRA
COOKIE_DOMAIN=                          # e.g. .yourdomain.com (prod only)
SESSION_SECRET=change-me

# RIT IdP (fill from RIT metadata)
SAML_IDP_ENTRYPOINT=https://shibboleth.main.ad.rit.edu/idp/profile/SAML2/Redirect/SSO
SAML_IDP_ENTITYID=https://shibboleth.main.ad.rit.edu/idp/shibboleth
SAML_IDP_CERT="-----BEGIN CERTIFICATE-----\n...paste pem...\n-----END CERTIFICATE-----"

# Your SP info
SAML_SP_ENTITYID=http://localhost:3001/sp
SAML_ACS_PATH=/saml/acs
