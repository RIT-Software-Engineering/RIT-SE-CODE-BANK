{{> header}}

<table width="100%" cellpadding="24"
  style="font-family:'Helvetica Neue','Helvetica','Roboto','Arial',sans-serif;
         color:#000000;
         background-color:#FFFFFF;
         line-height:1.5;
         max-width:600px;
         margin:0 auto;">
  <tr>
    <td>
      <h2 style="font-size:24px;line-height:32px;font-weight:700;margin-bottom:16px;">
        Peer Feedback Available
      </h2>

      <p style="font-size:16px;line-height:24px;margin-bottom:16px;">
        {{#if recipient.name}}
          Hi {{recipient.name}},
        {{else}}
          Hi there,
        {{/if}}
      </p>

      <p style="font-size:16px;line-height:24px;margin-bottom:16px;">
        Your feedback for the assessment
        {{#if item.title}}
            <strong>{{item.title}}</strong>
        {{else}}
        you completed
        {{/if}}
        has been reviewed and released by the project overseer. You can now sign in to PeerEval to view your feedback.
      </p>

      {{#if item.title}}
      <p style="font-size:16px;line-height:24px;margin-bottom:8px;">
        <strong>Assessment:</strong> {{item.title}}
      </p>
      {{/if}}

      {{#if item.projectName}}
      <p style="font-size:16px;line-height:24px;margin-bottom:8px;">
        <strong>Project:</strong> {{item.projectName}}
      </p>
      {{/if}}

      {{#if item.description}}
      <p style="font-size:16px;line-height:24px;margin-bottom:8px;">
        <strong>Description:</strong> {{item.description}}
      </p>
      {{/if}}

      {{#if cta.url}}
      <p style="margin-top:24px;margin-bottom:24px;">
        <a href="{{cta.url}}"
            style="display:inline-block;
                   background-color:#F76902;
                   color:#FFFFFF;
                   padding:12px 20px;
                   border-radius:4px;
                   text-decoration:none;
                   font-size:16px;
                   font-weight:500;">
          View Feedback in PeerEval
        </a>
      </p>
      {{/if}}

      <p style="font-size:16px;line-height:24px;margin-top:24px;">
        Thanks,<br>
        <strong>RIT Software Engineering Department</strong>
      </p>
    </td>
  </tr>
</table>

{{> footer}}
