
{{> header}}

<table width="100%" cellpadding="24"
  style="font-family:'Helvetica Neue','Helvetica','Roboto','Arial',sans-serif;
         color:#000000;
         background-color:#FFFFFF;
         line-height:1.5;
         max-width:600px;
         margin:0 auto;">
  <tr>
    <td>
      <h2 style="font-size:24px;line-height:32px;font-weight:700;margin-bottom:16px;">
        Peer Assessment Overdue
      </h2>

      <p style="font-size:16px;line-height:24px;margin-bottom:16px;">
        {{#if recipient.name}}
          Hi {{recipient.name}},
        {{else}}
          Hi,
        {{/if}}
      </p>

      <p style="font-size:16px;line-height:24px;margin-bottom:16px;">
        Our records show that the deadline for your peer evaluation has passed
        and you still have feedback to submit.
        Please complete your outstanding evaluation as soon as possible.
      </p>

      {{#if item.title}}
      <p style="font-size:16px;line-height:24px;margin-bottom:8px;">
        <strong>Assessment:</strong> {{item.title}}
      </p>
      {{/if}}

      {{#if item.projectName}}
      <p style="font-size:16px;line-height:24px;margin-bottom:8px;">
        <strong>Project:</strong> {{item.projectName}}
      </p>
      {{/if}}

      {{#if item.dueDate}}
      <p style="font-size:16px;line-height:24px;margin-bottom:8px;">
        <strong>Due Date:</strong> {{item.dueDate}}
      </p>
      {{/if}}

      {{#if cta.url}}
      <p style="margin-top:24px;margin-bottom:24px;">
        <a href="{{cta.url}}"
            style="display:inline-block;
                   background-color:#F76902;
                   color:#FFFFFF;
                   padding:12px 20px;
                   border-radius:4px;
                   text-decoration:none;
                   font-size:16px;
                   font-weight:500;">
          Complete Overdue Evaluation
        </a>
      </p>
      {{/if}}

      <p style="font-size:16px;line-height:24px;margin-top:24px;">
        Thanks,<br>
        <strong>RIT Software Engineering Department</strong>
      </p>
    </td>
  </tr>
</table>


{{> footer}}
