{{> header}}

<table width="100%" cellpadding="24"
  style="font-family:'Helvetica Neue','Helvetica','Roboto','Arial',sans-serif;
         color:#000000;
         background-color:#FFFFFF;
         line-height:1.5;
         max-width:600px;
         margin:0 auto;">
  <tr>
    <td>
      <h2 style="font-size:24px;line-height:32px;font-weight:700;margin-bottom:16px;">
        PeerEval Project Membership Update
      </h2>

      <p style="font-size:16px;line-height:24px;margin-bottom:16px;">
        {{#if recipient.name}}
          Hi {{recipient.name}},
        {{else}}
          Hi,
        {{/if}}
      </p>

      <p style="font-size:16px;line-height:24px;margin-bottom:16px;">
        You have been removed as a peer from the PeerEval project
        <strong>
          {{#if item.title}}{{item.title}}{{else}}a PeerEval project{{/if}}
        </strong>.
      </p>

      {{#if item.description}}
      <p style="font-size:16px;line-height:24px;margin-bottom:16px;">
        <strong>Project Description:</strong><br>
        {{item.description}}
      </p>
      {{/if}}

      <p style="font-size:16px;line-height:24px;margin-bottom:16px;">
        If you believe this change was made in error, please contact your project overseer.
      </p>

      <p style="font-size:16px;line-height:24px;margin-top:24px;">
        Thanks,<br>
        <strong>RIT Software Engineering Department</strong>
      </p>
    </td>
  </tr>
</table>

{{> footer}}