{{> header}}

<table width="100%" cellpadding="24"
    style="font-family:'Helvetica Neue','Helvetica','Roboto','Arial',sans-serif;
        color:#000000;
        background-color:#FFFFFF;
        line-height:1.5;
        max-width:600px;
        margin:0 auto;">
    <tr>
        <td>
        <h2 style="font-size:24px;line-height:32px;font-weight:700;margin-bottom:16px;">
            {{courseName}}: Update to material in the Schedule
        </h2>

        <p style="font-size:16px;line-height:24px;margin-bottom:16px;">
            Hi class,
        </p>

        <p style="font-size:16px;line-height:24px;margin-bottom:16px;">
            Please note the following update to the course material:
        </p>

        <ul>
            <li>Material {{changeText}}: {{#if isSyllabus}}The syllabus{{else}}{{itemLabel}}{{/if}}</li>
            {{#if sessionNum}}<li>From Session {{sessionNum}}</li>{{/if}}
        </ul>

        {{#if note}}
        <p style="font-size:16px;line-height:24px;margin-bottom:16px;">
            {{note}}
        </p>
        {{/if}}
        
        <p style="font-size:16px;line-height:24px;margin-top:24px;">
            Thank you,<br>
            <strong>RIT Software Engineering Department</strong>
        </p>
        </td>
    </tr>
</table>

{{> footer}}

