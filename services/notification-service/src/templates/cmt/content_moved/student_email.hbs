{{> header}}
<table width="100%" cellpadding="24"
    style="font-family:'Helvetica Neue','Helvetica','Roboto','Arial',sans-serif;
        color:#000000;
        background-color:#FFFFFF;
        line-height:1.5;
        max-width:600px;
        margin:0 auto;">
    <tr>
        <td>
        <h2 style="font-size:24px;line-height:32px;font-weight:700;margin-bottom:16px;">
            {{courseName}}: Content was moved in the Schedule
        </h2>

        <p style="font-size:16px;line-height:24px;margin-bottom:16px;">
            Hi class,
        </p>

        <p style="font-size:16px;line-height:24px;margin-bottom:16px;">
            There has been a change to the schedule. 
            Content ({{blockName}}) from Session {{from}} {{#if fromDate}}on {{fromDate}}{{/if}} has been moved to Session {{to}} {{#if toDate}}on {{toDate}}{{/if}}.
        </p>

        {{#if note}}
        <p style="font-size:16px;line-height:24px;margin-bottom:16px;">
            {{note}}
        </p>
        {{/if}}
        
        <p style="font-size:16px;line-height:24px;margin-top:24px;">
            Thank you,<br>
            <strong>RIT Software Engineering Department</strong>
        </p>
        </td>
    </tr>
</table>
{{> footer}}