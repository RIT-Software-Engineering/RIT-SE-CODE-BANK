{
  "name": "notification-service",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node scripts/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:dbpush": "prisma db push",
    "migrate:ta-portal": "node scripts/migrate-ta-portal-preferences.js --serviceUrl http://localhost:4000",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "prisma:deploy": "npx prisma migrate deploy --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "handlebars": "^4.7.8",
    "nodemailer": "^7.0.9"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "babel-jest": "^29.0.0",
    "jest": "^29.0.0",
    "prisma": "^5.0.0"
  }
}
